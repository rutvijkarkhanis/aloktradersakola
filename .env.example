# ============================================================================
# Alok Traders Akola — environment variables
# Copy to `.env.local` for local dev, and set these in Vercel for production.
# NEVER commit real secrets. Only NEXT_PUBLIC_* values are exposed to the browser.
# ============================================================================

# ---- Supabase (public) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Supabase (server only — NEVER expose to client) ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Business WhatsApp number in international format WITHOUT + or spaces (e.g. 9198XXXXXXXX).
# Leave blank until you have the real number — WhatsApp buttons hide themselves when unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---- Razorpay (server-side create/verify/webhook) ----
# In test mode use rzp_test_* keys. Keep SECRET + WEBHOOK_SECRET server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# The key id is also needed in the browser to open the checkout widget (public, not secret).
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ---- Storage ----
# Public bucket that holds product images. Created by the import script if missing.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=product-images

# ---- Email notifications (Resend — optional; inert until set) ----
# Order confirmations to customers + new-order/enquiry alerts to admin.
RESEND_API_KEY=
EMAIL_FROM=Alok Traders Akola <orders@yourdomain.com>
ADMIN_NOTIFICATION_EMAIL=

# ---- Big Ship (optional; automated shipping via Delhivery) ----
# Manual AWB paste in admin needs NONE of these. Fill in all five to enable the
# automated "Book with Big Ship" flow (create order -> rate -> AWB + label).
# Auth is login-based: username + password + access_key -> Bearer token.
BIGSHIP_BASE_URL=https://api.bigship.direct/
BIGSHIP_USERNAME=
BIGSHIP_PASSWORD=
BIGSHIP_ACCESS_KEY=
# Pickup warehouse id to ship from (Big Ship dashboard -> Warehouse / get-warehouse-list):
BIGSHIP_WAREHOUSE_ID=
# Insurance/risk type: 2=Owner Risk (default), 1=Third-Party, 3=Carrier:
BIGSHIP_RISK_TYPE_ID=2

